{
  "name": "asset-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "doctor": "node tool/doctor.mjs",
    "app": "node tool/doctor.mjs && next build && next start --hostname 127.0.0.1 --port 1230",
    "dev": "NEXT_DIST_DIR=.next-dev next dev --hostname 127.0.0.1 --port 1230",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 1230",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src tests next.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests next.config.ts playwright.config.ts",
    "test": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "zip": "bash tool/zip.sh",
    "app:build": "bash tool/build-app.sh"
  },
  "dependencies": {
    "@openai/codex": "0.160.1",
    "next": "15.5.25",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@google/design.md": "0.4.0",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
